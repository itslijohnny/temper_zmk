#include "temper.dtsi"

&default_transform {
    col-offset = <5>;
};

&kscan0 {
    col-gpios
        = <&pro_micro 15 GPIO_ACTIVE_HIGH>
        , <&pro_micro 18 GPIO_ACTIVE_HIGH>
        , <&pro_micro 19 GPIO_ACTIVE_HIGH>
        , <&pro_micro 20 GPIO_ACTIVE_HIGH>
        , <&pro_micro 21 GPIO_ACTIVE_HIGH>
        ;
};

// TPS43 Trackpad Configuration for Peripheral (Right Side)
// Using GPIO bit-banged I2C for 2-pin trackpad (SDA + SCL only)
// Connected to: D2/P0.17 (SDA) and D3/P0.20 (SCL)

/ {
    gpio_i2c: gpio-i2c {
        compatible = "gpio-i2c";
        #address-cells = <1>;
        #size-cells = <0>;
        status = "okay";
        
        // D2 (P0.17) = SDA, D3 (P0.20) = SCL
        sda-gpios = <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
        scl-gpios = <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
        
        // I2C timing (adjust if needed)
        clock-frequency = <100000>; // 100 kHz (standard mode)
        
        tps43: iqs5xx@74 {
            compatible = "azoteq,iqs5xx";
            reg = <0x74>;
            label = "TPS43";
            status = "okay";
            
            // RDY GPIO - Using P0.09 (D10) as dummy
            rdy-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
            
            // Reset GPIO - Using P0.06 (D4) as dummy
            reset-gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
            
            // Gesture configuration
            one-finger-tap;
            press-and-hold;
            press-and-hold-time = <250>;
            two-finger-tap;
            
            // Scrolling
            scroll;
            natural-scroll-y;
            
            // Sensitivity settings
            bottom-beta = <15>;
            stationary-threshold = <5>;
            
            // Axis configuration (may need adjustment based on orientation)
            // switch-xy;
            // flip-x;
            // flip-y;
        };
    };
};

// Configure the input-split to proxy trackpad data to central
&tps43_split {
    device = <&tps43>;
};
