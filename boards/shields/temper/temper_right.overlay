#include "temper.dtsi"

&default_transform {
    col-offset = <5>;
};

&kscan0 {
    col-gpios
        = <&pro_micro 15 GPIO_ACTIVE_HIGH>
        , <&pro_micro 18 GPIO_ACTIVE_HIGH>
        , <&pro_micro 19 GPIO_ACTIVE_HIGH>
        , <&pro_micro 20 GPIO_ACTIVE_HIGH>
        , <&pro_micro 21 GPIO_ACTIVE_HIGH>
        ;
};

// TPS43 Trackpad Configuration for Peripheral (Right Side)
// Connected to standard I2C pins: D2/P0.17 (SDA) and D3/P0.20 (SCL)
// Plus VCC and GND for power
&pro_micro_i2c {
    status = "okay";
    
    tps43: iqs5xx@74 {
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;
        label = "TPS43";
        status = "okay";
        
        // RDY GPIO - Required by driver. Using P0.09 (D10)
        // This pin is unused on your board and serves as a dummy pin
        // If your trackpad has a physical RDY pin, you can connect it to D10
        rdy-gpios = <&pro_micro 1 GPIO_ACTIVE_HIGH>;
        
        // dummy 
        reset-gpios = <&pro_micro 0 GPIO_ACTIVE_LOW>;
        
        // Gesture configuration
        one-finger-tap;
        press-and-hold;
        press-and-hold-time = <250>;
        two-finger-tap;
        
        // Scrolling
        scroll;
        natural-scroll-y;
        
        // Sensitivity settings
        bottom-beta = <15>;
        stationary-threshold = <5>;
        
        // Axis configuration (may need adjustment based on orientation)
        // Uncomment these if the trackpad orientation needs adjustment:
        // switch-xy;
        // flip-x;
        // flip-y;
    };
};

// Configure the input-split to proxy trackpad data to central
&tps43_split {
    device = <&tps43>;
};
