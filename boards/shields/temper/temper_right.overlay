#include "temper.dtsi"
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    tps43_input: tps43_input {
        compatible = "zmk,input-listener";
        device = <&tps43>;
    };
};

&default_transform {
    col-offset = <5>;
};

&kscan0 {
    col-gpios
        = <&pro_micro 15 GPIO_ACTIVE_HIGH>
        , <&pro_micro 18 GPIO_ACTIVE_HIGH>
        , <&pro_micro 19 GPIO_ACTIVE_HIGH>
        , <&pro_micro 20 GPIO_ACTIVE_HIGH>
        , <&pro_micro 21 GPIO_ACTIVE_HIGH>
        ;
};

// TPS43 Trackpad Configuration for Peripheral (Right Side)
// Connected to: D2/P0.17 (SDA) and D3/P0.20 (SCL)

&tps43 {
    status = "okay";
    
    // reset-gpios = <&pro_micro 0 GPIO_ACTIVE_LOW>;
    rdy-gpios = <&pro_micro 1 GPIO_ACTIVE_HIGH>;
    
    // Gesture configuration
    one-finger-tap;
    press-and-hold;
    press-and-hold-time = <250>;
    two-finger-tap;
    
    // Scrolling
    scroll;
    natural-scroll-y;
    
    // Sensitivity settings
    bottom-beta = <15>;
    stationary-threshold = <5>;
    
    // Axis configuration (may need adjustment based on orientation)
    // switch-xy;
    // flip-x;
    // flip-y;
};

// Configure the input-split to proxy trackpad data to central
&tps43_split {
    device = <&tps43>;
};
